# Copy to .env.local and fill in. Never commit the filled version.
# Names only — see docs/prompter-task-stage-2.md §7.1.
#
# No variable here may take a NEXT_PUBLIC_ prefix: that inlines the value into
# the client bundle, which for CLOUDINARY_URL would hand out the api_secret.

# Secret. Atlas connection string.
MONGODB_URI=

# Secret. cloudinary://<api_key>:<api_secret>@<cloud_name>
# One variable configures the whole SDK; do not split it into cloud-name/key/secret.
CLOUDINARY_URL=

# Generate with: openssl rand -base64 32
AUTH_SECRET=

# http://localhost:3000 locally, https://<domain> in production.
AUTH_URL=
